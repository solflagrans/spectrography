{
  "name": "spectrography",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "library:build": "tsx scripts/build-spectral-library.ts",
    "library:check": "tsx scripts/build-spectral-library.ts --check",
    "molecular:source": "tsx scripts/import-moose-molecular-source.ts",
    "molecular:build": "tsx scripts/build-molecular-library.ts",
    "molecular:check": "tsx scripts/build-molecular-library.ts --check",
    "experimental:import": "tsx scripts/import-open-air-plasma-spectrum.ts",
    "experimental:check": "tsx scripts/import-open-air-plasma-spectrum.ts --check",
    "regression:air-plasma": "tsx scripts/run-air-plasma-regression.ts",
    "verify:identification": "tsx scripts/run-identification-verification.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm library:check && pnpm molecular:check && pnpm experimental:check && pnpm verify:identification && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
